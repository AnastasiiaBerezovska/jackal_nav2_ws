<?xml version="1.0"?>
<package format="3">
  <name>jackal_nav2</name>
  <version>0.0.1</version>
  <description>Navigation configuration package for Jackal integrated with Nav2 and LIO-SAM</description>

  <maintainer email="robot@example.com">Robot User</maintainer>
  <license>BSD</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core dependencies -->
  <depend>rclcpp</depend>
  <depend>nav2_bringup</depend>
  <depend>nav2_core</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Optional: for RViz visualization -->
  <exec_depend>rviz2</exec_depend>

  <!-- Export section -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
